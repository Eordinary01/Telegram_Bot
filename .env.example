NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://jecrc:jecrc_dev_password@localhost:5433/jecrc_mail?schema=public
REDIS_URL=redis://localhost:6379

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Token Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key

# JWT auth secret for dashboard/API session (min 32 chars)
JWT_SECRET=your-strong-32-character-plus-jwt-secret
JWT_EXPIRES_IN=24h

# Allowed sender domain for email filtering
ALLOWED_SENDER_DOMAIN=jecrcu.edu.in

# Gmail Push Notifications (Phase 2 - Optional for development)
# Leave commented for manual sync testing, or set up ngrok for webhooks
# GMAIL_PUSH_ENDPOINT=https://your-ngrok-url.ngrok.io/webhooks/gmail
# PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push

# Telegram Bot (get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Admin email for developer tools access (inject-test, clear-test, waitlist management)
ADMIN_EMAIL=admin@yourdomain.com
